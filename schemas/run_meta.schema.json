{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/run_meta.schema.json",
  "title": "Run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "question",
    "mode",
    "protocol",
    "revisions",
    "history"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^rg-[0-9]{8}-[0-9]{3}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "GUIDED",
        "MANUAL"
      ]
    },
    "protocol": {
      "enum": [
        "OPEN",
        "FROZEN"
      ]
    },
    "frozen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max",
          "used"
        ],
        "properties": {
          "max": {
            "type": "integer"
          },
          "used": {
            "type": "integer"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "gate",
          "outcome"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "gate": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "retired_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "campaign_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archived_at", "archive_path", "run_count", "run_ids_sha256",
          "run_manifest_content_hash", "raw_results_content_hash", "payload_sha256"
        ],
        "properties": {
          "archived_at": {"type": "string", "format": "date-time"},
          "archive_path": {
            "type": "string",
            "pattern": "^logs/rejected-campaigns/[0-9a-f]{16}$"
          },
          "run_count": {"type": "integer", "minimum": 1},
          "run_ids_sha256": {
            "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/sha"
          },
          "run_manifest_content_hash": {
            "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/hash"
          },
          "raw_results_content_hash": {
            "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/hash"
          },
          "payload_sha256": {
            "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/hash"
          }
        }
      }
    },
    "provenance": {
      "enum": [
        "recorded",
        "synthetic"
      ],
      "description": "recorded: every artifact was written by the identity it names. synthetic: the run is a fixture; identities are illustrative."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of this file with the field itself removed. `rgraph seal` stamps it."
    }
  }
}
