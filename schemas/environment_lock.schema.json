{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-graph.dev/schemas/environment_lock.schema.json",
  "title": "environment_lock",
  "allOf": [
    {
      "$ref": "https://research-graph.dev/schemas/_envelope.schema.json"
    }
  ],
  "properties": {
    "artifact_id": {
      "const": "environment_lock"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "packages",
        "lock_sha256"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "lock_sha256": {
          "$ref": "https://research-graph.dev/schemas/_envelope.schema.json#/$defs/sha"
        }
      }
    }
  }
}
