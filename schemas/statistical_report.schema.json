{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/statistical_report.schema.json",
  "title": "statistical_report",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json"
    }
  ],
  "properties": {
    "artifact_id": {
      "const": "statistical_report"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimates",
        "multiplicity_correction",
        "effect_sizes"
      ],
      "properties": {
        "estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "metric",
              "estimate",
              "ci_lower",
              "ci_upper",
              "ci_level",
              "n",
              "method",
              "assumptions_checked"
            ],
            "properties": {
              "result_id": {
                "type": "string",
                "pattern": "^r-[0-9]{2,}$"
              },
              "metric": {
                "type": "string"
              },
              "estimate": {
                "type": "number"
              },
              "ci_lower": {
                "type": "number"
              },
              "ci_upper": {
                "type": "number"
              },
              "ci_level": {
                "const": 0.95
              },
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "config_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
              },
              "p_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Optional. Required whenever multiplicity_correction names a procedure that acts on p-values, so a correction cannot be claimed without the quantities it corrects."
              },
              "p_adjusted": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Optional. The p_value after the correction named in multiplicity_correction."
              },
              "method": {
                "type": "string"
              },
              "assumptions_checked": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "passed"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "passed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "minItems": 1
        },
        "multiplicity_correction": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect_sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_id",
              "name",
              "value"
            ],
            "properties": {
              "result_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {"version": {"minimum": 2}}
  },
  "then": {
    "allOf": [
      {
        "properties": {
          "body": {
            "properties": {
              "estimates": {
                "items": {"required": ["config_ids"]}
              }
            }
          }
        }
      },
      {
        "properties": {
          "inputs": {
            "contains": {
              "properties": {"artifact_id": {"const": "raw_results"}},
              "required": ["artifact_id", "content_hash"]
            },
            "minContains": 1
          }
        }
      },
      {
        "properties": {
          "inputs": {
            "contains": {
              "properties": {"artifact_id": {"const": "run_manifest"}},
              "required": ["artifact_id", "content_hash"]
            },
            "minContains": 1
          }
        }
      },
      {
        "properties": {
          "inputs": {
            "contains": {
              "properties": {"artifact_id": {"const": "frozen_protocol"}},
              "required": ["artifact_id", "content_hash"]
            },
            "minContains": 1
          }
        }
      }
    ]
  }
}
