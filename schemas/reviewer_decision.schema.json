{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/reviewer_decision.schema.json",
  "title": "Reviewer decision proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "reason", "checks", "findings"],
  "properties": {
    "outcome": {"enum": ["pass", "revise", "block"]},
    "reason": {
      "enum": ["evidence_gap", "hypothesis_defect", "scope_plan_defect",
               "assumption_violation", "code_run_defect", "claim_support_gap",
               "revision", null]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "SKIP", "CAVEAT"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "code", "detail", "fix"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "code": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "pass"}}},
      "then": {
        "properties": {
          "reason": {"const": null},
          "checks": {"not": {"contains": {"properties": {"status": {"const": "FAIL"}}}}}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "revise"}}},
      "then": {
        "properties": {
          "reason": {"type": "string"},
          "checks": {"contains": {"properties": {"status": {"const": "FAIL"}}}}
        }
      }
    }
  ]
}
