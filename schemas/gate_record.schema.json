{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/gate_record.schema.json",
  "title": "Gate record",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "outcome", "decided_at", "decided_by", "separation_level",
               "separation_caveat", "inputs", "checks", "revision_budget"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
    "outcome": {"enum": ["pass", "revise", "block", "release", "narrow", "null-result", "stop"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "decided_by": {"$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/actor"},
    "producer_identity": {"type": ["string", "null"]},
    "separation_level": {"enum": ["context_only", "separate_model", "separate_provider", null]},
    "separation_caveat": {"type": "boolean"},
    "inputs": {
      "type": "array",
      "items": {"$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/input_ref"}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "SKIP", "CAVEAT"]},
          "detail": {"type": "string"}
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "answers"],
      "description": "What a human was asked at this gate and what they answered. A human gate without one was never decided by anybody.",
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "answered"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "answered": {"enum": ["yes", "no"]}
            }
          }
        }
      }
    },
    "reason": {"enum": ["evidence_gap", "hypothesis_defect", "scope_plan_defect",
                        "assumption_violation", "code_run_defect", "claim_support_gap",
                        "revision", null]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "code", "detail"],
        "properties": {
          "ref": {"type": "string"},
          "code": {"type": "string"},
          "detail": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    },
    "revision_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "used"],
      "properties": {
        "max": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0}
      }
    }
  }
}
