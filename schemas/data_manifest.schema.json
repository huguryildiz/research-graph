{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-graph.dev/schemas/data_manifest.schema.json",
  "title": "data_manifest",
  "allOf": [
    {
      "$ref": "https://research-graph.dev/schemas/_envelope.schema.json"
    }
  ],
  "properties": {
    "artifact_id": {
      "const": "data_manifest"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasets"
      ],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_id",
              "path",
              "sha256",
              "bytes",
              "generated"
            ],
            "properties": {
              "dataset_id": {
                "type": "string",
                "pattern": "^d-[0-9]{2,}$"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "https://research-graph.dev/schemas/_envelope.schema.json#/$defs/sha"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "rows": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "generated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
