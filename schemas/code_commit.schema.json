{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/code_commit.schema.json",
  "title": "code_commit",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json"
    }
  ],
  "properties": {
    "artifact_id": {
      "const": "code_commit"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "commit",
        "dirty",
        "entrypoint",
        "files"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "entrypoint": {
          "type": "string"
        },
        "bundle_path": {
          "type": "string",
          "pattern": "^code/[A-Za-z0-9._/-]+\\.bundle$"
        },
        "bundle_sha256": {
          "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/hash"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "repo_path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/sha"
              }
            }
          },
          "minItems": 1
        }
      }
    }
  },
  "if": {
    "properties": {
      "version": {"minimum": 2}
    }
  },
  "then": {
    "properties": {
      "body": {
        "required": [
          "repo",
          "commit",
          "dirty",
          "entrypoint",
          "bundle_path",
          "bundle_sha256",
          "files"
        ],
        "properties": {
          "commit": {"pattern": "^[0-9a-f]{40}$"},
          "dirty": {"const": false},
          "files": {
            "items": {
              "required": ["path", "repo_path", "sha256"]
            }
          }
        }
      }
    }
  }
}
