{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/run_manifest.schema.json",
  "title": "run_manifest",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json"
    }
  ],
  "properties": {
    "artifact_id": {
      "const": "run_manifest"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replications",
        "seeds",
        "runs",
        "failures"
      ],
      "properties": {
        "replications": {
          "type": "integer",
          "minimum": 1
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["config_id", "path", "sha256", "argv"],
            "properties": {
              "config_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "path": {
                "type": "string",
                "pattern": "^config/[A-Za-z0-9._/-]+$"
              },
              "sha256": {
                "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/sha"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "seed",
              "config_sha256",
              "started_at",
              "finished_at",
              "status"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "seed": {
                "type": "integer"
              },
              "config_sha256": {
                "$ref": "https://raw.githubusercontent.com/huguryildiz/research-graph/main/schemas/_envelope.schema.json#/$defs/sha"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "ok",
                  "failed"
                ]
              }
            }
          },
          "minItems": 1
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "if": {
    "properties": {
      "version": {"minimum": 2}
    }
  },
  "then": {
    "allOf": [
      {
        "properties": {
          "body": {
            "required": ["replications", "seeds", "configurations", "runs", "failures"]
          }
        }
      },
      {
        "properties": {
          "inputs": {
            "contains": {
              "properties": {"artifact_id": {"const": "code_commit"}},
              "required": ["artifact_id", "content_hash"]
            },
            "minContains": 1
          }
        }
      },
      {
        "properties": {
          "inputs": {
            "contains": {
              "properties": {"artifact_id": {"const": "environment_lock"}},
              "required": ["artifact_id", "content_hash"]
            },
            "minContains": 1
          }
        }
      },
      {
        "properties": {
          "inputs": {
            "contains": {
              "properties": {"artifact_id": {"const": "data_manifest"}},
              "required": ["artifact_id", "content_hash"]
            },
            "minContains": 1
          }
        }
      }
    ]
  }
}
