      {
        "claim_id": "c-01",
        "text": "At -10 dB SNR the learned estimator lowers MSE by 2.092 dB relative to scalar-Wiener LMMSE (95% CI [1.44, 2.709], n=20).",
        "location": {
          "file": "manuscript.md",
          "section": "Results"
        },
        "supported_by": {
