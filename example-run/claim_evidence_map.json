        },
        "scope": "within_evidence"
      },
      {
        "claim_id": "c-02",
        "text": "At 0 dB SNR the gain is 6.492 dB (95% CI [5.812, 7.163], n=20).",
        "location": {
          "file": "manuscript.md",
          "section": "Results"
        },
        "supported_by": {
          "result_ids": [
            "r-03"
          ],
          "source_ids": []
        },
        "scope": "within_evidence"
      },
      {
        "claim_id": "c-03",
        "text": "Across the grid that was run, the advantage grows with SNR rather than shrinking, so the hypothesis that it peaks at low SNR is not supported.",
        "location": {
          "file": "manuscript.md",
          "section": "Results"
        },
        "supported_by": {
